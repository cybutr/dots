[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/share/applications/*.desktop
Target = usr/lib/*/resources/app.asar
Target = opt/*/resources/app.asar

[Action]
Description = Injecting --force-renderer-accessibility into Electron .desktop launchers...
When = PostTransaction
Exec = /usr/bin/runuser -u czeddaru -- /usr/bin/python3 /home/czeddaru/.config/hypr/scripts/electron-a11y.py
